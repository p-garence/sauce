# Pour Better Auth, ton nom de domaine
ORIGIN="https://ton-vrai-domaine.com"

BETTER_AUTH_SECRET="vrai-secret-genere-en-prod"

# Endroit sur le disque hôte avec les données.
HOST_DATA_PATH="./data"

# PostgreSQL
POSTGRES_USER="root"
POSTGRES_PASSWORD="vrai-mot-de-passe"
POSTGRES_DB="social"

# Pour le dev
DOCKER_ORIGIN="http://localhost:4539"
DATABASE_URL="postgres://root:vrai-mot-de-passe@db:5432/social"

# Web Push VAPID keys TODO comment générer
PUBLIC_VAPID_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Configuration SMTP (Optionnel - Pour réinitialisation mot de passe & alertes)
# Si non configuré, les liens s'affichent dans les logs de l'application
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="Réseau Social <noreply@ton-vrai-domaine.com>"