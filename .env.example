# -----------------------------------------------------------------------------
# Configuration de l'Application
# -----------------------------------------------------------------------------
# URL publique d'accès au frontend (sans slash final)
# En dev local : http://localhost:5173
# En production : https://ton-domaine.com
ORIGIN="http://localhost:5173"

# Secret Better Auth pour signer les sessions et cookies
# En dev : la valeur par défaut ci-dessous convient
# En prod : générer une clé cryptographique avec la commande :
# openssl rand -base64 32
BETTER_AUTH_SECRET="faux-secret-de-dev"

# Dossier sur la machine hôte où stocker les données persistantes (PostgreSQL et médias /uploads)
HOST_DATA_PATH="./data_dev"

# -----------------------------------------------------------------------------
# Base de données PostgreSQL (Docker)
# -----------------------------------------------------------------------------
POSTGRES_USER="root"
POSTGRES_PASSWORD="vrai-mot-de-passe"
POSTGRES_DB="social"

# -----------------------------------------------------------------------------
# Autres
# -----------------------------------------------------------------------------
# URL d'origine pour le conteneur Docker. ne pas changer
DOCKER_ORIGIN="http://localhost:4539"

# Pour le dev local
DATABASE_URL="postgres://root:vrai-mot-de-passe@localhost:5432/social"

# -----------------------------------------------------------------------------
# Web Push
# -----------------------------------------------------------------------------
# Pour générer une paire de clés VAPID :
# npx web-push generate-vapid-keys
# (Il est recommandé de générer un jeu de clés distinct par environnement dev / prod)
PUBLIC_VAPID_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@ton-domaine.com"

# -----------------------------------------------------------------------------
# Configuration SMTP (Optionnel - Pour envoi d'e-mails & réinitialisation de mot de passe)
# -----------------------------------------------------------------------------
# Si non configuré, les liens de validation et réinitialisation s'affichent directement dans les logs de l'application
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="Sauce et Ail <noreply@ton-domaine.com>"