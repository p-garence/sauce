{
	"name": "social-front2",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run docs:build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check src && eslint .",
		"format": "prettier --write src tests *.ts *.json",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"docs:dev": "npm --prefix docs run dev",
		"docs:build": "ASTRO_TELEMETRY_DISABLED=1 npm --prefix docs run build",
		"docs:preview": "npm --prefix docs run preview",
		"audit:bundle": "ANALYZE=true vite build",
		"audit:lighthouse": "playwright test --config=playwright.audit.config.ts"
	},
	"dependencies": {
		"@lucide/svelte": "^1.55.0",
		"auth": "^1.6.23",
		"better-auth": "^1.6.23",
		"drizzle-orm": "^0.45.2",
		"postgres": "^3.4.9",
		"sharp": "^0.35.5",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"@types/web-push": "^3.6.4",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lighthouse": "^13.5.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"rollup-plugin-visualizer": "^7.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.0"
		}
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	}
}
